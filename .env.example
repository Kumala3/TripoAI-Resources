# Firecrawl
FIRECRAWL_KEY=your_firecrawl_api_key_here

# URL to scrape for ticket availability
TICKET_URL=https://example.com/tickets

# Comma-separated keywords to detect (case-insensitive)
TICKET_KEYWORDS=available,buy now,add to cart

# Twilio credentials
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+15550000000
TWILIO_TO=+15551111111

# Hour window in UTC+2 (integers, END_HOUR is exclusive)
# Example: START_HOUR=8, END_HOUR=22 → active 08:00–21:59 UTC+2
START_HOUR=8
END_HOUR=22

# Secret for cron job authorization (must match value set in Vercel dashboard)
CRON_SECRET=your_random_secret_here
